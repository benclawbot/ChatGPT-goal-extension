{
  "manifest_version": 3,
  "name": "ChatGPT Goals",
  "version": "1.1.0",
  "description": "Run persistent ChatGPT goals through an automatic continuation loop until completion.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["src/store.js", "src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "ChatGPT Goals",
    "default_popup": "src/popup.html"
  }
}
